# Copy to .env and adjust. Never commit .env.

# Port and interface of the local dashboard/API server.
MMP_PORT=4477
MMP_HOST=127.0.0.1

# Where mmp stores its SQLite database (default: ~/.manage-my-projects).
# MMP_DATA_DIR=

# Open the browser automatically on `mmp start`.
MMP_OPEN_BROWSER=true

# Extra Host headers accepted by the server, comma separated
# (e.g. a Laragon virtual host that reverse-proxies to mmp).
# MMP_ALLOWED_HOSTS=manage_my_project.test
